{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationReport",
  "type": "object",
  "required": ["valid", "violations", "summary"],
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Violation"
      }
    },
    "freeze": {
      "$ref": "#/definitions/FreezeState"
    },
    "summary": {
      "type": "string"
    }
  },
  "definitions": {
    "Violation": {
      "type": "object",
      "required": ["code", "severity", "message", "path", "evidence", "remediation"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "AIT1_IMPLICIT_AUTHORITY",
            "AIT1_MISSING_DELEGATION_PATH",
            "MOC_DECISION_NOT_GATED",
            "MOC_EXECUTION_NOT_GATED",
            "CPT1_SEMANTIC_DRIFT",
            "CPT1_TEMPORAL_STALE",
            "CPT1_GOAL_CONSTRAINT_CONFLICT",
            "SBAA_SPLIT_BRAIN",
            "OMEGA_UNDEFINED_TERM_USED_IN_DECISION",
            "OMEGA_IRREVERSIBLE_WITHOUT_SIGNOFF",
            "OMEGA_IMPLICIT_AUTHORITY_IN_TEXT",
            "SCHEMA_VALIDATION_ERROR"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["warn", "fail", "freeze"]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "evidence": {
          "type": "object"
        },
        "remediation": {
          "type": "string"
        }
      }
    },
    "FreezeState": {
      "type": "object",
      "required": ["frozen", "violations"],
      "properties": {
        "frozen": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Violation"
          }
        }
      }
    }
  }
}
